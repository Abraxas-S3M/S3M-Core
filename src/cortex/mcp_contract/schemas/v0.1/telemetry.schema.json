{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s3m:cortex-mcp:0.1:telemetry",
  "title": "S3M Cortex telemetry event v0.1",
  "description": "One envelope for all events. Attribute names follow OpenTelemetry semantic conventions where one exists (network.*, server.*, client.*); s3m.* otherwise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "type",
    "time",
    "source",
    "tenant",
    "severity",
    "attributes"
  ],
  "properties": {
    "schema": {
      "const": "s3m.cortex.telemetry/0.1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "type": {
      "enum": [
        "flow.summary",
        "stlink.heartbeat",
        "tunnel.state",
        "auth.decision",
        "change.applied",
        "change.rolled_back",
        "policy.denied",
        "anomaly.flag"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "enum": [
            "control-plane",
            "cortex",
            "approval-authority"
          ]
        },
        "component": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "system",
        "component"
      ]
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "sandbox": {
      "type": "string",
      "pattern": "^sbx-[a-z0-9-]{1,40}$"
    },
    "severity": {
      "enum": [
        "debug",
        "info",
        "warning",
        "critical"
      ]
    },
    "attributes": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "flow.summary"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/FlowSummaryAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stlink.heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/StlinkHeartbeatAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tunnel.state"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/TunnelStateAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "auth.decision"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/AuthDecisionAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "change.applied"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/ChangeAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "change.rolled_back"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/ChangeAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.denied"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/AuthDecisionAttributes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "anomaly.flag"
          }
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "$ref": "#/$defs/AnomalyAttributes"
          }
        }
      }
    }
  ],
  "$defs": {
    "FlowSummaryAttributes": {
      "type": "object",
      "properties": {
        "s3m.route.id": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/RouteId"
        },
        "s3m.window.start": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/Timestamp"
        },
        "s3m.window.seconds": {
          "const": 300
        },
        "network.transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "server.port": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/Port"
        },
        "s3m.service": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/Service"
        },
        "s3m.sessions": {
          "type": "integer",
          "minimum": 0
        },
        "s3m.unique_sources": {
          "type": "integer",
          "minimum": 0
        },
        "s3m.bytes_in": {
          "type": "integer",
          "minimum": 0
        },
        "s3m.bytes_out": {
          "type": "integer",
          "minimum": 0
        },
        "s3m.denied_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "s3m.sealed_tunnel": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "s3m.route.id",
        "s3m.window.start",
        "s3m.window.seconds",
        "s3m.sessions",
        "s3m.denied_attempts"
      ]
    },
    "StlinkHeartbeatAttributes": {
      "type": "object",
      "properties": {
        "s3m.stlink.id": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/StlinkId"
        },
        "s3m.status": {
          "enum": [
            "active",
            "disabled",
            "degraded"
          ]
        },
        "s3m.latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "s3m.tunnels": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "s3m.stlink.id",
        "s3m.status",
        "s3m.latency_ms"
      ]
    },
    "TunnelStateAttributes": {
      "type": "object",
      "properties": {
        "s3m.tunnel.id": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/TunnelId"
        },
        "s3m.route.id": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/RouteId"
        },
        "s3m.status": {
          "enum": [
            "up",
            "down",
            "degraded"
          ]
        },
        "s3m.rekey_age_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "s3m.tunnel.id",
        "s3m.status"
      ]
    },
    "AuthDecisionAttributes": {
      "type": "object",
      "properties": {
        "s3m.tool": {
          "type": "string",
          "maxLength": 64
        },
        "s3m.decision": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "s3m.code": {
          "type": "string",
          "maxLength": 40
        },
        "client.id": {
          "type": "string",
          "maxLength": 64
        },
        "s3m.request_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "s3m.tool",
        "s3m.decision",
        "client.id"
      ]
    },
    "ChangeAttributes": {
      "type": "object",
      "properties": {
        "s3m.tool": {
          "type": "string",
          "maxLength": 64
        },
        "s3m.resource": {
          "type": "string",
          "maxLength": 80
        },
        "s3m.receipt.digest": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/Sha256Hex"
        },
        "s3m.approval.jti": {
          "type": "string",
          "maxLength": 64
        },
        "client.id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "s3m.tool",
        "s3m.resource",
        "client.id"
      ]
    },
    "AnomalyAttributes": {
      "type": "object",
      "properties": {
        "s3m.route.id": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/RouteId"
        },
        "s3m.kind": {
          "enum": [
            "denied_spike",
            "new_source",
            "volume_spike",
            "tunnel_flap"
          ]
        },
        "s3m.score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "s3m.detail": {
          "$ref": "urn:s3m:cortex-mcp:0.1:common#/$defs/UntrustedText"
        }
      },
      "additionalProperties": false,
      "required": [
        "s3m.kind",
        "s3m.score"
      ]
    }
  }
}
